# Configuration de production. Sur le serveur, copier ce fichier sous le nom .env
# (à côté de compose.prod.yaml) puis renseigner les valeurs. Ne jamais le publier.

# Adresse du site, sans https://. En attendant un nom de domaine, utiliser le nom d’hôte
# du VPS affiché dans hPanel (du type srv123456.hstgr.cloud).
DOMAIN=

# Mot de passe de la base PostgreSQL. Lettres et chiffres uniquement :
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Premier administrateur, créé par « npm run db:seed ».
# ADMIN_USERNAME est l’identifiant de connexion (lettres, chiffres, points ou tirets).
# Mot de passe : 12 caractères minimum. Il peut être effacé d’ici une fois le compte créé.
ADMIN_PHONE=
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=

# Coordonnées publiques de la page Contact. Vides, elles ne sont pas affichées.
# Elles se modifient ensuite depuis l’administration (Paramètres), qui a alors priorité.
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
